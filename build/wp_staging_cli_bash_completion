# Bash completion script for wpstaging
#
# This script provides command-line auto-completion for wpstaging.
# To enable completion, copy this file to the /etc/bash_completion.d/ directory.
#
# Usage:
#   source /etc/bash_completion.d/wpstaging
#
# Author: WP Staging <https://wp-staging.com/support/>
# License: MIT

# Return a multi-line hint string for the given command. Printed above the
# prompt when the user presses TAB at a position where the completion would
# otherwise offer nothing (e.g. a hostname the script cannot enumerate).
_wp_staging_cli_hint_text() {
    case "$1" in
        add)
            printf 'Examples:\n  wpstaging add https://newsite.local\n  wpstaging add newsite.local\n  wpstaging add newsite.local --from=backup.wpstg\n  wpstaging add newsite.local --from=https://example.com/backup.wpstg'
            ;;
        shell)
            printf 'Examples:\n  wpstaging shell newsite.local\n  wpstaging shell newsite.local root'
            ;;
        shell-db)
            printf 'Examples:\n  wpstaging shell-db newsite.local\n  wpstaging shell-db newsite.local root'
            ;;
        switch-php)
            printf 'Examples:\n  wpstaging switch-php newsite.local 8.3\n  wpstaging switch-php newsite.local 7.4'
            ;;
        switch-wp)
            printf 'Examples:\n  wpstaging switch-wp newsite.local latest\n  wpstaging switch-wp newsite.local nightly'
            ;;
        enable|disable|reset|start|up|stop|down|restart|compose-info|update-subdomains|usub)
            printf 'Examples:\n  wpstaging %s newsite.local' "$1"
            ;;
    esac
}

# Print a hint message above the current prompt if the user pressed TAB at the
# given positional index with an empty current word. Returns 0 if a hint was
# shown (caller should return from the completion function), 1 otherwise.
_wp_staging_cli_maybe_hint() {
    local cmd="$1"
    local pos="${2:-2}"
    [[ ${COMP_CWORD} -eq ${pos} && -z "${cur}" ]] || return 1
    local hint
    hint="$(_wp_staging_cli_hint_text "$cmd")"
    [[ -n "$hint" ]] || return 1
    printf '\n%s\n' "$hint" >&2
    COMPREPLY=()
    return 0
}

_wp_staging_cli() {
    local cur prev commands general_opts restore_opts only_opts skip_opts
    local add_opts reset_opts env_path_only_opts root_only_opts
    COMPREPLY=()

    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # NOTE: `sudo-keepalive` is intentionally omitted. It is an internal command
    # spawned by the CLI to refresh sudo credentials in the background and is
    # not meant to be invoked by users -- do not add it to completion.
    commands="
        add
        clean
        sweep-ca-trust
        compose-info
        deactivate
        del
        diagnostics
        disable
        docker-image
        docker-start
        dump-all-help
        dump-header
        dump-index
        dump-metadata
        enable
        extract
        generate-compose-file
        generate-docker-file
        help
        list
        magic-link
        open
        reconfigure
        register
        reinstall-ca
        reinstall-cert
        reset
        restart
        restore
        shell
        shell-db
        start
        status
        stop
        switch-php
        switch-wp
        sync-status
        remove
        uninstall
        update
        update-subdomains
        update-hosts-file
        verify-cert
    "

    # Clean subcommands
    clean_subcommands="
        all
        cache
        license
        wpcli
    "

    # General options (available on all subcommands)
    general_opts="
        -l --license
        --working-dir
        --skip-config
        --config
        --yes
        --prompt-timeout
        -d --debug
        -q --quiet
        --verbose
        --json
        --page
        --page-size
        -h --help
    "

    # Root-only options (only meaningful at top level, not inside subcommands)
    root_only_opts="
        -v --version
        --about
    "

    # Only-Filters options
    only_opts="
        -r --only-wproot
        -w --only-wpcontent
        -i --only-plugins
        -t --only-themes
        -m --only-muplugins
        -u --only-uploads
        -g --only-languages
        -b --only-dbfile
        -e --only-dropins
        -f --only-file
    "

    # Skip-Filters options
    skip_opts="
        -R --skip-wproot
        -W --skip-wpcontent
        -I --skip-plugins
        -T --skip-themes
        -M --skip-muplugins
        -U --skip-uploads
        -G --skip-languages
        -B --skip-dbfile
        -E --skip-dropins
        -F --skip-file
    "

    # Extract-specific options
    extract_opts="
        -o --output-dir
        -n --normalizedb
        --site-url
        --db-prefix
        --overwrite
        --verify
        --from
        --download-dir
    "

    # Restore-specific options
    restore_opts="
        -o --output-dir
        -p --path
        --site-url
        --overwrite
        --overwrite-db
        --overwrite-wproot
        --db-prefix
        --db-innodb-strict-mode
        --db-file
        --db-batch-size
        --db-insert-single
        --db-timeout
        --verify
        --skip-extract
        --from
        --db-host
        --db-name
        --db-user
        --db-password
        --db-socket
        --db-charset
        --db-collate
        --db-ssl-ca-cert
        --db-ssl-cert
        --db-ssl-key
        --db-ssl-mode
        --download-dir
    "

    # Per-command dockerize flag sets (matches addDockerizeFlags in cmd/dockerizeCmd.go).
    # Only flags VISIBLE in normal help output are listed. Hidden flags
    # (--skip-update-hosts-file, --skip-macos-auto-ip, --external-db,
    # --compose-file on most commands, --container-ip on most commands,
    # and all alias flags) are intentionally excluded from completion.

    # add: full visible set (addPathAndComposeFlags + addServiceConfigFlags +
    #       addServiceToggleFlags + addWordPressConfigFlags + extras)
    add_opts="
        --env-path
        --compose-file
        --container-ip
        --php
        --http-port
        --https-port
        --db-port
        --db-root
        --mailpit-http-port
        --disable-mailpit
        --disable-adminer
        --disable-adminer-autologin
        --disable-magic-link
        --magic-link-timeout
        --wp
        --db-host
        --db-name
        --db-user
        --db-pass
        --db-prefix
        --db-ssl
        --admin-user
        --admin-pass
        --admin-email
        --label
        --secure-credentials
        --multisite
        --subdomains
        --from
        --skip-warmup
        --fast-mode
    "

    # reset: addPathOnlyFlag + --from + --wp + --disable-mailpit + --disable-adminer
    reset_opts="
        --env-path
        --from
        --wp
        --disable-mailpit
        --disable-adminer
        --disable-adminer-autologin
        --disable-magic-link
        --magic-link-timeout
        --skip-warmup
    "

    # start / up / restart: addPathAndComposeOnlyFlag (hidden) + --skip-warmup
    start_opts="
        --env-path
        --skip-warmup
    "

    # generate-docker-file / generate-compose-file: add path + compose + --disable-mailpit + --disable-adminer
    generate_docker_file_opts="
        --env-path
        --disable-mailpit
        --disable-adminer
        --disable-adminer-autologin
        --disable-magic-link
        --magic-link-timeout
    "

    # reconfigure: generate_docker_file_opts plus --site-label (label-only fast
    # path) and --install-wp-staging-pro (install Pro on an existing site)
    reconfigure_opts="
        --env-path
        --disable-mailpit
        --disable-adminer
        --disable-adminer-autologin
        --disable-magic-link
        --magic-link-timeout
        --site-label
        --install-wp-staging-pro
        --skip-warmup
    "

    # magic-link <hostname> [--timeout MINUTES]
    magic_link_opts="
        --timeout
    "

    # All other dockerize subcommands (except shell-db and reinstall-cert):
    # only --env-path is visible. Other registered flags (--compose-file,
    # --container-ip, --skip-update-hosts-file, etc.) are hidden in Go.
    env_path_only_opts="--env-path"

    # Detect if Only or Skip filter is already used
    local has_only=false
    local has_skip=false
    for word in "${COMP_WORDS[@]}"; do
        if [[ "$word" == --only-* || "$word" =~ ^-[rwitmubgef]$ ]]; then
            has_only=true
        fi
        if [[ "$word" == --skip-* || "$word" =~ ^-[RWITMUBGEF]$ ]]; then
            has_skip=true
        fi
    done

    # Handle top-level command completion
    if [[ ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${commands} ${root_only_opts} ${general_opts}" -- "${cur}") )
        return
    fi

    # Handle clean subcommands
    if [[ "${COMP_WORDS[1]}" == "clean" && ${COMP_CWORD} -eq 2 ]]; then
        COMPREPLY=( $(compgen -W "${clean_subcommands}" -- "${cur}") )
        return
    fi

    case "${COMP_WORDS[1]}" in
        extract)
            if [[ ${COMP_CWORD} -eq 2 ]]; then
                COMPREPLY=( $(compgen -f -X '!*.wpstg' -- "${cur}") )
            else
                local opts="${general_opts} ${extract_opts}"

                # contextual filters
                if [[ "$has_only" == true ]]; then
                    opts="${opts} ${only_opts}"
                elif [[ "$has_skip" == true ]]; then
                    opts="${opts} ${skip_opts}"
                else
                    opts="${opts} ${only_opts} ${skip_opts}"
                fi

                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            fi
            ;;
        restore)
            if [[ ${COMP_CWORD} -eq 2 ]]; then
                COMPREPLY=( $(compgen -f -X '!*.wpstg' -- "${cur}") )
            else
                local opts="${general_opts} ${restore_opts}"

                # contextual filters
                if [[ "$has_only" == true ]]; then
                    opts="${opts} ${only_opts}"
                elif [[ "$has_skip" == true ]]; then
                    opts="${opts} ${skip_opts}"
                else
                    opts="${opts} ${only_opts} ${skip_opts}"
                fi

                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            fi
            ;;
        dump-header|dh|dump-metadata|dm)
            if [[ ${COMP_CWORD} -eq 2 ]]; then
                COMPREPLY=( $(compgen -f -X '!*.wpstg' -- "${cur}") )
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${only_opts} ${skip_opts}" -- "${cur}") )
            fi
            ;;
        dump-index|di)
            if [[ ${COMP_CWORD} -eq 2 ]]; then
                COMPREPLY=( $(compgen -f -X '!*.wpstg' -- "${cur}") )
            else
                COMPREPLY=( $(compgen -W "--data ${general_opts} ${only_opts} ${skip_opts}" -- "${cur}") )
            fi
            ;;
        dump-all-help)
            COMPREPLY=( $(compgen -W "--html --markdown ${general_opts}" -- "${cur}") )
            ;;
        switch-php)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 3 ]]; then
                COMPREPLY=( $(compgen -W "7.4 8.1 8.2 8.3 8.4" -- "${cur}") )
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            fi
            ;;
        switch-wp)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 3 ]]; then
                COMPREPLY=( $(compgen -W "latest nightly" -- "${cur}") )
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            fi
            ;;
        list)
            # list [hostname...] — hostname is optional (no hostname = all).
            # No hint: the command runs with zero args, so flag completion must work.
            COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            ;;
        status)
            # status [hostname...] — hostname is optional (no hostname = all).
            COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            ;;
        update-subdomains|usub)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # First positional: hostname
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            fi
            ;;
        add)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # First positional: site URL
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${add_opts}" -- "${cur}") )
            fi
            ;;
        del)
            # del [hostname...] — hostname is optional (no hostname = delete all).
            # No hint: the hint would imply a required positional.
            if [[ "${cur}" != -* ]]; then
                # Positional: hostname(s)
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            fi
            ;;
        shell)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # First positional: hostname
                COMPREPLY=()
            elif [[ ${COMP_CWORD} -eq 3 && "${cur}" != -* ]]; then
                # Second positional: optional root
                COMPREPLY=( $(compgen -W "root" -- "${cur}") )
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            fi
            ;;
        shell-db)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # First positional: hostname
                COMPREPLY=()
            elif [[ ${COMP_CWORD} -eq 3 && "${cur}" != -* ]]; then
                # Second positional: optional root
                COMPREPLY=( $(compgen -W "root" -- "${cur}") )
            else
                # All dockerize flags hidden in Go; only general opts apply.
                COMPREPLY=( $(compgen -W "${general_opts}" -- "${cur}") )
            fi
            ;;
        reset)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # First positional: hostname
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${reset_opts}" -- "${cur}") )
            fi
            ;;
        enable|disable)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # First positional: hostname
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            fi
            ;;
        start|up|restart)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # First positional: hostname
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${start_opts}" -- "${cur}") )
            fi
            ;;
        stop|down)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # First positional: hostname
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            fi
            ;;
        compose-info)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # First positional: hostname
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            fi
            ;;
        generate-compose-file|gcf|generate-docker-file|gdf)
            # generate-*-file [hostname] -- hostname is optional
            # (no hostname = apply to all sites). No hint: would imply a
            # required positional.
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # Optional first positional: hostname
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${generate_docker_file_opts}" -- "${cur}") )
            fi
            ;;
        reconfigure|rcf)
            # reconfigure [hostname] -- hostname is optional (no hostname = apply
            # to all sites). Adds --site-label for the metadata-only fast path.
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${reconfigure_opts}" -- "${cur}") )
            fi
            ;;
        magic-link)
            _wp_staging_cli_maybe_hint "${COMP_WORDS[1]}" && return
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # Required first positional: hostname
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "${general_opts} ${magic_link_opts}" -- "${cur}") )
            fi
            ;;
        remove)
            COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            ;;
        update-hosts-file|uhf)
            COMPREPLY=( $(compgen -W "${general_opts} ${env_path_only_opts}" -- "${cur}") )
            ;;
        reinstall-cert)
            # reinstall-cert [hostname] -- hostname is optional (no hostname =
            # apply to all sites). No hint: would imply a required positional.
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                # Optional first positional: hostname
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "--env-path --reinstall-ca --skip-restart ${general_opts}" -- "${cur}") )
            fi
            ;;
        reinstall-ca)
            COMPREPLY=( $(compgen -W "--env-path --skip-restart --skip-leaf ${general_opts}" -- "${cur}") )
            ;;
        verify-cert)
            # verify-cert [hostname] -- hostname is optional (no hostname =
            # audit every site).
            if [[ ${COMP_CWORD} -eq 2 && "${cur}" != -* ]]; then
                COMPREPLY=()
            else
                COMPREPLY=( $(compgen -W "--env-path --live ${general_opts}" -- "${cur}") )
            fi
            ;;
        sweep-ca-trust)
            COMPREPLY=( $(compgen -W "--env-path --dry-run --include-legacy ${general_opts}" -- "${cur}") )
            ;;
        docker-start)
            COMPREPLY=( $(compgen -W "--timeout --status ${general_opts}" -- "${cur}") )
            ;;
        docker-image)
            COMPREPLY=( $(compgen -W "--status --php ${general_opts}" -- "${cur}") )
            ;;
        diagnostics)
            COMPREPLY=( $(compgen -W "--env-path ${general_opts}" -- "${cur}") )
            ;;
        register)
            COMPREPLY=( $(compgen -W "--license --status ${general_opts}" -- "${cur}") )
            ;;
        uninstall)
            COMPREPLY=( $(compgen -W "--full ${general_opts}" -- "${cur}") )
            ;;
        update)
            COMPREPLY=( $(compgen -W "--acks --acknowledge --check --clear-acks --clear-cache --full --status --version ${general_opts}" -- "${cur}") )
            ;;
        deactivate|unregister|clean)
            COMPREPLY=( $(compgen -W "${general_opts}" -- "${cur}") )
            ;;
        help)
            COMPREPLY=( $(compgen -W "${commands}" -- "${cur}") )
            ;;
        *)
            COMPREPLY=( $(compgen -W "${general_opts}" -- "${cur}") )
            ;;
    esac

    # Value suggestions for specific options
    case "${prev}" in
        --overwrite|--overwrite-db|--overwrite-wproot)
            COMPREPLY=( $(compgen -W "yes no" -- "${cur}") )
            return
            ;;
        --php)
            COMPREPLY=( $(compgen -W "7.4 8.1 8.2 8.3 8.4" -- "${cur}") )
            return
            ;;
        --db-ssl-mode)
            COMPREPLY=( $(compgen -W "skip-verify preferred" -- "${cur}") )
            return
            ;;
        --wp)
            COMPREPLY=( $(compgen -W "latest nightly" -- "${cur}") )
            return
            ;;
    esac

    # File/path suggestions
    case "${prev}" in
        -o|--output-dir|--outputdir|--download-dir|--working-dir|--workingdir|-p|--path|--db-file|--db-socket|--db-ssl-ca-cert|--db-ssl-cert|--db-ssl-key|--compose-file|--env-path)
            COMPREPLY=( $(compgen -o filenames -- "${cur}") )
            return
            ;;
        --config)
            COMPREPLY=( $(compgen -f -X '!*.conf' -- "${cur}") )
            return
            ;;
    esac
}

complete -F _wp_staging_cli wpstaging
complete -F _wp_staging_cli ./wpstaging
