#compdef wpstaging
#
# Zsh completion script for wpstaging
#
# This script provides command-line auto-completion for wpstaging.
# To enable completion, add this to your ~/.zshrc:
#   fpath=(~/.zsh/completions $fpath)
#   autoload -Uz compinit && compinit
# Then copy this file to ~/.zsh/completions/_wpstaging
#
# Author: WP Staging <https://wp-staging.com/support/>
# License: MIT

# Display a usage hint when the user presses TAB at a positional argument
# whose value cannot be enumerated (e.g. hostnames or new site URLs). Uses
# _message so the hint shows below the prompt without offering selectable
# candidates. The current subcommand is read from $words[1], which inside the
# subcommand's _arguments context refers to the subcommand name.
#
# The $PREFIX guard ensures the hint only fires when the current word is
# empty — if the user has already typed partial input (e.g. `wpstaging add
# new<TAB>`), fall back to normal completion behaviour. Mirrors the
# `-z "$cur"` check in the bash `_wp_staging_cli_maybe_hint` helper.
_wpstaging_hint() {
    [[ -z "$PREFIX" ]] || return 0
    local subcmd="${words[1]}"
    case "$subcmd" in
        add)
            _message -r $'Examples:\n  wpstaging add https://newsite.local\n  wpstaging add newsite.local\n  wpstaging add newsite.local --from=backup.wpstg\n  wpstaging add newsite.local --from=https://example.com/backup.wpstg'
            ;;
        shell)
            _message -r $'Examples:\n  wpstaging shell newsite.local\n  wpstaging shell newsite.local root'
            ;;
        shell-db)
            _message -r $'Examples:\n  wpstaging shell-db newsite.local\n  wpstaging shell-db newsite.local root'
            ;;
        switch-php)
            _message -r $'Examples:\n  wpstaging switch-php newsite.local 8.3\n  wpstaging switch-php newsite.local 7.4'
            ;;
        switch-wp)
            _message -r $'Examples:\n  wpstaging switch-wp newsite.local latest\n  wpstaging switch-wp newsite.local nightly'
            ;;
        reinstall-cert)
            _message -r $'Examples:\n  wpstaging reinstall-cert newsite.local\n  wpstaging reinstall-cert newsite.local --reinstall-ca'
            ;;
        enable|disable|reset|start|up|stop|down|restart|compose-info|update-subdomains|usub)
            _message -r "Examples:
  wpstaging ${subcmd} newsite.local"
            ;;
    esac
}

_wpstaging() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    local -a commands
    commands=(
        'add:Create a new dockerized WordPress site'
        'clean:Clean cache, license, or all data'
        'compose-info:Show Docker Compose information'
        'deactivate:Deactivate license from this machine'
        'del:Delete a dockerized site'
        'disable:Disable a site (stop and prevent auto-start)'
        'dump-all-help:Dump help for all commands'
        'dump-header:Dump backup file header'
        'dump-index:Dump backup file index'
        'dump-metadata:Dump backup file metadata'
        'enable:Enable a disabled site'
        'extract:Extract files from a backup'
        'generate-compose-file:Generate Docker Compose file'
        'generate-docker-file:Generate Dockerfile'
        'help:Show help for a command'
        'list:List all dockerized sites'
        'reconfigure:Reconfigure a site and apply the changes'
        'register:Register license key'
        'reinstall-cert:Reinstall SSL certificate'
        'reset:Reset WordPress installation'
        'restart:Restart site containers'
        'restore:Restore WordPress from backup'
        'shell:Open shell in PHP container'
        'shell-db:Open shell in database container'
        'start:Start site containers'
        'status:Show site status'
        'stop:Stop site containers'
        'switch-php:Switch PHP version for a site'
        'switch-wp:Switch WordPress version for a site'
        'remove:Stop containers and remove all Docker data'
        'uninstall:Uninstall WP Staging CLI from the system'
        'update:Update WP Staging CLI to latest version'
        'update-subdomains:Sync subdomain multisite hostnames from WordPress'
        'update-hosts-file:Update /etc/hosts'
    )

    local -a clean_subcommands
    clean_subcommands=(
        'all:Clean all data'
        'cache:Clean cache only'
        'license:Clean license cache'
    )

    # General options (available on all subcommands)
    local -a general_opts
    general_opts=(
        '(-l --license)'{-l,--license}'[License key]:license key:'
        '(-o --outputdir)'{-o,--outputdir}'[Output directory]:directory:_files -/'
        '--workingdir[Working directory]:directory:_files -/'
        '--skip-config[Skip config file]'
        '--config[Config file]:config file:_files -g "*.conf"'
        '--yes[Auto-confirm prompts]'
        '--prompt-timeout[Prompt timeout in seconds]:seconds:'
        '(-d --debug)'{-d,--debug}'[Enable debug mode]'
        '(-q --quiet)'{-q,--quiet}'[Quiet mode]'
        '--verbose[Show detailed per-file output during extraction]'
        '--json[Output in JSON format]'
        '--page[Page number for paginated output (requires --json)]:page number:'
        '--page-size[Items per page, 0 = all (requires --json)]:items per page:'
        '(-h --help)'{-h,--help}'[Show help]'
    )

    # Root-only options (only meaningful at top level, not inside subcommands)
    local -a root_only_opts
    root_only_opts=(
        '(-v --version)'{-v,--version}'[Show version]'
        '--about[Show about information]'
    )

    local -a only_opts
    only_opts=(
        '(-r --only-wproot)'{-r,--only-wproot}'[Only WordPress root files]'
        '(-w --only-wpcontent)'{-w,--only-wpcontent}'[Only wp-content directory]'
        '(-i --only-plugins)'{-i,--only-plugins}'[Only plugins]'
        '(-t --only-themes)'{-t,--only-themes}'[Only themes]'
        '(-m --only-muplugins)'{-m,--only-muplugins}'[Only mu-plugins]'
        '(-u --only-uploads)'{-u,--only-uploads}'[Only uploads]'
        '(-g --only-languages)'{-g,--only-languages}'[Only languages]'
        '(-b --only-dbfile)'{-b,--only-dbfile}'[Only database file]'
        '(-e --only-dropins)'{-e,--only-dropins}'[Only drop-ins]'
        '(-f --only-file)'{-f,--only-file}'[Only specific file]:file pattern:'
    )

    local -a skip_opts
    skip_opts=(
        '(-R --skip-wproot)'{-R,--skip-wproot}'[Skip WordPress root files]'
        '(-W --skip-wpcontent)'{-W,--skip-wpcontent}'[Skip wp-content directory]'
        '(-I --skip-plugins)'{-I,--skip-plugins}'[Skip plugins]'
        '(-T --skip-themes)'{-T,--skip-themes}'[Skip themes]'
        '(-M --skip-muplugins)'{-M,--skip-muplugins}'[Skip mu-plugins]'
        '(-U --skip-uploads)'{-U,--skip-uploads}'[Skip uploads]'
        '(-G --skip-languages)'{-G,--skip-languages}'[Skip languages]'
        '(-B --skip-dbfile)'{-B,--skip-dbfile}'[Skip database file]'
        '(-E --skip-dropins)'{-E,--skip-dropins}'[Skip drop-ins]'
        '(-F --skip-file)'{-F,--skip-file}'[Skip specific file]:file pattern:'
    )

    local -a extract_opts
    extract_opts=(
        '(-n --normalizedb)'{-n,--normalizedb}'[Normalize database file]'
        '--site-url[Target site URL]:URL:'
        '--db-prefix[Database table prefix]:prefix:'
        '--overwrite[Overwrite existing files]:overwrite:(yes no all)'
        '--verify[Verify extracted files]'
        '--from[Backup file or URL]:backup:_files -g "*.wpstg"'
    )

    local -a restore_opts
    restore_opts=(
        '(-p --path)'{-p,--path}'[WordPress installation path]:path:_files -/'
        '--site-url[Target site URL]:URL:'
        '--overwrite[Overwrite files]:overwrite:(yes no all)'
        '--overwrite-db[Overwrite database]:overwrite:(yes no)'
        '--overwrite-wproot[Overwrite WP root]:overwrite:(yes no)'
        '--db-prefix[Database table prefix]:prefix:'
        '--db-innodb-strict-mode[Enable InnoDB strict mode]'
        '--db-file[Database SQL file]:file:_files -g "*.sql"'
        '--db-batch-size[Insert batch size]:size:'
        '--db-insert-single[Use single-row inserts]'
        '--db-timeout[Database timeout]:timeout:'
        '--verify[Verify extracted files]'
        '--skip-extract[Skip extraction]'
        '--from[Backup file or URL]:backup:_files -g "*.wpstg"'
        '--db-host[Database host]:host:'
        '--db-name[Database name]:name:'
        '--db-user[Database user]:user:'
        '--db-password[Database password]:password:'
        '--db-socket[Database socket]:socket:_files'
        '--db-charset[Database charset]:charset:'
        '--db-collate[Database collation]:collation:'
        '--db-ssl-ca-cert[SSL CA certificate]:file:_files'
        '--db-ssl-cert[SSL client certificate]:file:_files'
        '--db-ssl-key[SSL client key]:file:_files'
        '--db-ssl-mode[SSL mode]:mode:(skip-verify preferred)'
        '--env-path[Environment file path]:path:_files'
        '--compose-file[Docker Compose file]:file:_files -g "*.yml"'
        '--skip-update-hosts-file[Skip updating hosts file]'
    )

    # Per-command dockerize flag sets (matches addDockerizeFlags in cmd/dockerizeCmd.go).
    # Only flags VISIBLE in normal help output are listed. Hidden flags
    # (--skip-update-hosts-file, --skip-macos-auto-ip, --external-db,
    # --compose-file on most commands, --container-ip on most commands,
    # and all alias flags) are intentionally excluded from completion.

    # add: full visible set (addPathAndComposeFlags + addServiceConfigFlags +
    #       addServiceToggleFlags + addWordPressConfigFlags + extras)
    local -a add_opts
    add_opts=(
        '--env-path[Environment file path]:path:_files'
        '--compose-file[Docker Compose file]:file:_files -g "*.yml"'
        '--container-ip[Container IP address]:IP:'
        '--php[PHP version]:version:(7.4 8.1 8.2 8.3 8.4)'
        '--http-port[HTTP port]:port:'
        '--https-port[HTTPS port]:port:'
        '--db-port[Database port]:port:'
        '--db-root[Database root password]:password:'
        '--mailpit-http-port[Mailpit HTTP port]:port:'
        '--disable-mailpit[Disable Mailpit]'
        '--disable-adminer[Disable the Adminer database UI (use =false to re-enable)]'
        '--disable-adminer-autologin[Disable Adminer auto-login (use =false to re-enable)]'
        '--wp[WordPress version]:version:{compadd -S "" -- latest nightly}'
        '--db-host[Database host]:host:'
        '--db-name[Database name]:name:'
        '--db-user[Database user]:user:'
        '--db-pass[Database password]:password:'
        '--db-prefix[Database table prefix]:prefix:'
        '--db-ssl[Enable database SSL]'
        '--admin-user[WordPress admin username]:user:'
        '--admin-pass[WordPress admin password]:password:'
        '--admin-email[WordPress admin email]:email:'
        '--secure-credentials[Generate secure random credentials]'
        '--multisite[Enable WordPress Multisite]'
        '--subdomains=-[Enable subdomain multisite. Optional: comma-separated hostnames]::hostnames:'
        '--from[Restore from backup]:backup:_files -g "*.wpstg"'
    )

    # reset: addPathOnlyFlag + --from + --wp + --disable-adminer
    local -a reset_opts
    reset_opts=(
        '--env-path[Environment file path]:path:_files'
        '--from[Restore from backup]:backup:_files -g "*.wpstg"'
        '--wp[WordPress version]:version:{compadd -S "" -- latest nightly}'
        '--disable-adminer[Disable the Adminer database UI (use =false to re-enable)]'
        '--disable-adminer-autologin[Disable Adminer auto-login (use =false to re-enable)]'
    )

    # generate-docker-file / generate-compose-file: path flags + --disable-adminer
    local -a generate_docker_file_opts
    generate_docker_file_opts=(
        '--env-path[Environment file path]:path:_files'
        '--disable-adminer[Disable the Adminer database UI (use =false to re-enable)]'
        '--disable-adminer-autologin[Disable Adminer auto-login (use =false to re-enable)]'
    )

    # All other dockerize subcommands (except shell-db and reinstall-cert):
    # only --env-path is visible. Other registered flags (--compose-file,
    # --container-ip, --skip-update-hosts-file, etc.) are hidden in Go.
    local -a env_path_only_opts
    env_path_only_opts=(
        '--env-path[Environment file path]:path:_files'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args'

    # Detect if Only or Skip filter is already used
    local has_only=false has_skip=false
    local w
    for w in "${words[@]}"; do
        case $w in
            --only-*|-[rwitmubgef]) has_only=true ;;
            --skip-*|-[RWITMUBGEF]) has_skip=true ;;
        esac
    done

    # Build contextual filter options
    local -a filter_opts
    if [[ $has_only == true ]]; then
        filter_opts=($only_opts)
    elif [[ $has_skip == true ]]; then
        filter_opts=($skip_opts)
    else
        filter_opts=($only_opts $skip_opts)
    fi

    case $state in
        command)
            _describe -t commands 'wpstaging command' commands
            _arguments $root_only_opts $general_opts
            ;;
        args)
            case $words[1] in
                extract)
                    _arguments \
                        '1:backup file:_files -g "*.wpstg"' \
                        $general_opts \
                        $extract_opts \
                        $filter_opts
                    ;;
                restore)
                    _arguments \
                        '1:backup file:_files -g "*.wpstg"' \
                        $general_opts \
                        $restore_opts \
                        $filter_opts
                    ;;
                dump-header|dh|dump-metadata|dm)
                    _arguments \
                        '1:backup file:_files -g "*.wpstg"' \
                        $general_opts \
                        $filter_opts
                    ;;
                dump-index|di)
                    _arguments \
                        '1:backup file:_files -g "*.wpstg"' \
                        '--data[Display detailed index data]' \
                        $general_opts \
                        $filter_opts
                    ;;
                dump-all-help)
                    _arguments \
                        '--html[Output in HTML format]' \
                        '--markdown[Output in Markdown format]' \
                        $general_opts
                    ;;
                clean)
                    _arguments \
                        '1: :->subcommand' \
                        $general_opts
                    if [[ $state == subcommand ]]; then
                        _describe -t subcommands 'clean subcommand' clean_subcommands
                    fi
                    ;;
                add)
                    _arguments \
                        '1:site URL:_wpstaging_hint' \
                        $general_opts \
                        $add_opts
                    ;;
                switch-php)
                    _arguments \
                        '1:hostname:_wpstaging_hint' \
                        '2:PHP version:(7.4 8.1 8.2 8.3 8.4)' \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                switch-wp)
                    _arguments \
                        '1:hostname:_wpstaging_hint' \
                        '2:WordPress version:{compadd -S "" -- latest nightly}' \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                list)
                    # list [hostname...] — hostname is optional.
                    _arguments \
                        '*:hostname:' \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                status)
                    # status [hostname...] — hostname is optional.
                    _arguments \
                        '*:hostname:' \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                del)
                    # del [hostname...] — hostname is optional (no hostname = delete all).
                    _arguments \
                        '*:hostname:' \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                shell)
                    _arguments \
                        '1:hostname:_wpstaging_hint' \
                        '2::root:(root)' \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                shell-db)
                    # All dockerize flags hidden in Go; only general opts apply.
                    _arguments \
                        '1:hostname:_wpstaging_hint' \
                        '2::root:(root)' \
                        $general_opts
                    ;;
                reset)
                    _arguments \
                        '1:hostname:_wpstaging_hint' \
                        $general_opts \
                        $reset_opts
                    ;;
                enable|disable)
                    _arguments \
                        '1:hostname:_wpstaging_hint' \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                start|up|stop|down|restart)
                    _arguments \
                        '1:hostname:_wpstaging_hint' \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                remove)
                    _arguments \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                update-subdomains|usub)
                    _arguments \
                        '1:hostname:_wpstaging_hint' \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                compose-info)
                    _arguments \
                        '1:hostname:_wpstaging_hint' \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                generate-compose-file|gcf|generate-docker-file|gdf|reconfigure|rcf)
                    # generate-*-file / reconfigure [hostname] -- hostname is optional.
                    _arguments \
                        '1::hostname:' \
                        $general_opts \
                        $generate_docker_file_opts
                    ;;
                update-hosts-file|uhf)
                    _arguments \
                        $general_opts \
                        $env_path_only_opts
                    ;;
                reinstall-cert)
                    _arguments \
                        '1:hostname:_wpstaging_hint' \
                        '--env-path[Environment file path]:path:_files' \
                        '--reinstall-ca[Reinstall CA certificate]' \
                        $general_opts
                    ;;
                register)
                    _arguments \
                        '--license[License key]:key:' \
                        $general_opts
                    ;;
                uninstall)
                    _arguments \
                        '--full[Uninstall using uninstall script]' \
                        $general_opts
                    ;;
                update)
                    _arguments \
                        '--check[Only check for updates]' \
                        '--full[Update using install script]' \
                        '--version[Target a specific version]:version:' \
                        $general_opts
                    ;;
                deactivate|unregister)
                    _arguments $general_opts
                    ;;
                help)
                    _describe -t commands 'wpstaging command' commands
                    ;;
                *)
                    _arguments $general_opts
                    ;;
            esac
            ;;
    esac
}

# Register completion - works both when sourced directly and via fpath
compdef _wpstaging wpstaging
